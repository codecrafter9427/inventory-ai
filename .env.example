# Inventory AI — environment placeholders
# Copy to .env (repo root and/or backend/). Never commit real secrets.

# =============================================================================
# DEMO (local portfolio) — safe defaults
# =============================================================================
# PostgreSQL (matches docker-compose.yml; host port 5435)
DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5435/inventory_ai

JWT_SECRET=change-me-demo-secret
# Demo JWT lifetime in hours (see README security notes)
JWT_ACCESS_TOKEN_HOURS=24
DEMO_MODE=true

# Seeded demo users (password for all: demo-password)
# Owner/Admin:            admin@demo.inventory.local
# Inventory Manager:      manager@demo.inventory.local
# Staff:                  staff@demo.inventory.local
# Second-org user:        other@demo.inventory.local
DEMO_ADMIN_EMAIL=admin@demo.inventory.local
DEMO_ADMIN_PASSWORD=demo-password

# Soft policy targets (documented; demo passwords may be shorter)
PASSWORD_MIN_LENGTH=10
LOGIN_RATE_LIMIT_PER_MINUTE=10

# AI — DemoAI is default (no paid APIs). Ollama optional.
AI_PROVIDER=demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Insights connector (Agent 5) — leave empty to keep connector disabled (401)
INSIGHTS_CONNECTOR_TOKEN=

# Web (Next.js) — copy to web/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# =============================================================================
# PROD-LIKE (still portfolio — not production SSO)
# =============================================================================
# DEMO_MODE=false
# JWT_SECRET=<long-random-secret>
# JWT_ACCESS_TOKEN_HOURS=8
# PASSWORD_MIN_LENGTH=12
# LOGIN_RATE_LIMIT_PER_MINUTE=5
# INSIGHTS_CONNECTOR_TOKEN=<long-random-service-token>
# CORS_ORIGINS=https://your-frontend.example
# AI_PROVIDER=demo
# DATABASE_URL=postgresql+psycopg://user:pass@db-host:5432/inventory_ai
