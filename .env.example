# Inventory AI — local environment placeholders only
# Copy to .env (repo root and/or backend/). Never commit real secrets.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5435/inventory_ai

# Demo auth / JWT (placeholder — replace for any non-local use)
JWT_SECRET=change-me-demo-secret
DEMO_MODE=true

# Seeded demo users (password for all: demo-password)
# Owner/Admin:            admin@demo.inventory.local
# Inventory Manager:      manager@demo.inventory.local
# Staff:                  staff@demo.inventory.local
# Second-org user (tenant isolation tests): other@demo.inventory.local
DEMO_ADMIN_EMAIL=admin@demo.inventory.local
DEMO_ADMIN_PASSWORD=demo-password

# Optional local Ollama (not required — DemoAIProvider is the default fallback)
AI_PROVIDER=demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Web (Next.js) — copy to web/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
